pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'DESTROY',
            defaultValue: false,
            description: 'Tick to destroy the infrastructure instead of creating it'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        // No keys here. AWS access comes from the IAM role on this EC2 server.
        AWS_DEFAULT_REGION = 'ap-south-1'
        TF_IN_AUTOMATION   = 'true'
    }

    stages {

        // Stage 1: Reuse the repo and credentials configured in the Jenkins job
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Stage 2: Confirm tools and AWS identity
        stage('Verify Tools') {
            steps {
                sh 'terraform -version'
                sh 'aws sts get-caller-identity || echo "aws cli not installed, skipping identity check"'
            }
        }

        // Stage 3: Download the AWS provider
        stage('Terraform Init') {
            steps {
                sh 'terraform init -input=false'
            }
        }

        // Stage 4: Check formatting and syntax
        stage('Terraform Validate') {
            steps {
                sh 'terraform fmt -check'
                sh 'terraform validate'
            }
        }

        // Stage 5: Show what will be created and save the plan
        stage('Terraform Plan') {
            when { expression { return !params.DESTROY } }
            steps {
                sh 'terraform plan -input=false -out=tfplan'
            }
        }

        // Stage 6: Human approval
        stage('Manual Approval') {
            when { expression { return !params.DESTROY } }
            steps {
                input message: 'Approve Terraform Apply?', ok: 'Apply'
            }
        }

        // Stage 7: Create the S3 bucket from the saved plan
        stage('Terraform Apply') {
            when { expression { return !params.DESTROY } }
            steps {
                sh 'terraform apply -input=false -auto-approve tfplan'
                sh 'terraform output'
            }
        }

        // Destroy flow (only when DESTROY is ticked)
        stage('Plan Destroy') {
            when { expression { return params.DESTROY } }
            steps {
                sh 'terraform plan -destroy -input=false -out=tfplan-destroy'
            }
        }

        stage('Approve Destroy') {
            when { expression { return params.DESTROY } }
            steps {
                input message: 'Approve Terraform DESTROY?', ok: 'Destroy'
            }
        }

        stage('Terraform Destroy') {
            when { expression { return params.DESTROY } }
            steps {
                sh 'terraform apply -input=false -auto-approve tfplan-destroy'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed, check the logs.'
        }
        always {
            script {
                try {
                    cleanWs()
                } catch (err) {
                    echo "Workspace cleanup skipped: ${err.message}"
                }
            }
        }
    }
}
