# Terraform working directory (provider downloads)
.terraform/

# State files (can contain secrets)
*.tfstate
*.tfstate.*

# Saved plan files
tfplan
tfplan-destroy
*.tfplan

# Variable files that may hold secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# OS and editor files
.DS_Store
Thumbs.db
.vscode/

*.terraform.lock.hcl